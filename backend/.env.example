DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fedrepo
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
EVIDENCE_WARMUP_ON_STARTUP=true
AI_MAX_WORKERS=1
AI_JOB_MAX_ATTEMPTS=2
AI_JOB_TIMEOUT_SECONDS=90
AI_MAX_PENDING_JOBS=50
AI_PREFETCH_ENABLED=true
AI_WARMUP_MODE=recent
AI_WARMUP_RECENT_VERSIONS=3
AI_WARMUP_MAX_JOBS=5
AI_VERSION_ANALYSIS_MAX_TOKENS=500
AI_REPORT_MAX_TOKENS=1500
